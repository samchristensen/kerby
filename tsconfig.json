{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": ["packages", "services", "scripts", ".railway"],
  // The console's Next.js pages (JSX, the DOM) have their own config: `make typecheck` runs both.
  "exclude": [
    "**/node_modules",
    "**/.next",
    "services/console/src/app",
    "services/console/next.config.ts"
  ]
}
