// `make knip`: dead files, unused exports and types, unused or undeclared dependencies. Every workspace is
// internal, so package entry files are checked too (`includeEntryExports`): an export no workspace imports is dead.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "vitest.config.ts"],
      "project": ["scripts/**/*.ts", "*.ts"],
      // The Makefile runs it (`pnpm exec biome`); knip reads package.json scripts, not the Makefile.
      "ignoreDependencies": ["@biomejs/biome"]
    },
    // Each workspace's other entries come from its package.json `exports`: `src/index.ts` (a service's too), and the
    // `./testing` and `./providers` subpaths. The console's pages and `next.config.ts` come from knip's Next.js plugin.
    "services/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "services/console": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      // Imported from CSS (`@import "tailwindcss"` in src/app/globals.css), which knip does not read.
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  // A default export read by a tool, not imported: vitest's config. It exports nothing else.
  // A single export kept for another reason carries a `@public` JSDoc tag (knip skips it) that says why.
  // The SDK's entry is the public surface customers import (ADR 0023): no workspace imports most of it.
  "ignoreIssues": {
    "vitest.config.ts": ["exports"],
    "packages/sdk/src/index.ts": ["exports", "types"]
  }
}
